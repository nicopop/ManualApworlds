{
    "$schema": "https://github.com/ManualForArchipelago/Manual/raw/main/schemas/Manual.regions.schema.json",
    "Forest": {
        "starting": true,
        "connects_to": ["Snow", "Desert", "Jungle", "Corruption", "Crimson", "Left Ocean", "Right Ocean"]
    },
    "Snow": {
        "starting": false,
        "requires": "|Snow Biome|"
    },
    "Desert": {
        "starting": false,
        "requires": "|Desert Biome|"
    },
    "Jungle": {
        "starting": false,
        "requires": "|Jungle Biome|"
    },
    "Corruption": {
        "starting": false,
        "requires": "|Corruption Biome:all|",
        "_comment": ["Corruption Biome:all so that this region doesn't fail unit tests",
            "TODO when we have a link to hell make sure to exit check for the token instead of all"]
    },
    "Crimson": {
        "starting": false,
        "requires": "|Crimson Biome:all|"
    },
    "Left Ocean": {
        "starting": false,
        "requires": "|Left Ocean Biome|"
    },
    "Right Ocean": {
        "starting": false,
        "requires": "|Right Ocean Biome|"
    }
}